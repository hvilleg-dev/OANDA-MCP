# ============================================================================
# OANDA MCP Server — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# OANDA API Credentials (REQUIRED)
# ────────────────────────────────────────────────────────────────────────────

# Get from: https://www.oanda.com -> My Accounts -> API Access
# Format: Long alphanumeric string (128 chars+)
OANDA_API_KEY=your_api_key_here_at_least_128_characters_long

# Get from: https://www.oanda.com -> My Accounts
# Format: {siteID}-{divisionID}-{userID}-{accountNumber}
# Example: 001-011-5838423-001
OANDA_ACCOUNT_ID=your_account_id_here

# Environment: 'practice' (demo money) or 'live' (real money)
# ⚠️ WARNING: live trading executes real orders with real money!
# Always start with 'practice'
OANDA_ENVIRONMENT=practice

# ────────────────────────────────────────────────────────────────────────────
# Database Configuration (OPTIONAL)
# ────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for audit logging
# Format: postgresql://user:password@host:port/database
# If not set, server runs without database (no audit logging)
# Default works with docker-compose setup
DATABASE_URL=postgresql://oanda:oanda@db:5432/oanda_mcp

# ────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────────────────────────────────────────

# Server port (default: 8000)
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────────────────
# Rate Limiting (OPTIONAL)
# ────────────────────────────────────────────────────────────────────────────

# Requests per minute per client
# OANDA limit: ~200 req/s, most endpoints 10 req/s
# Set to 0 to disable rate limiting (not recommended)
RATE_LIMIT_PER_MINUTE=100

# ────────────────────────────────────────────────────────────────────────────
# Advanced Configuration
# ────────────────────────────────────────────────────────────────────────────

# Retry attempts for failed API calls
RETRY_ATTEMPTS=3

# Backoff multiplier for exponential backoff (seconds)
RETRY_BACKOFF_MULTIPLIER=2

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ────────────────────────────────────────────────────────────────────────────
# Development / Debug
# ────────────────────────────────────────────────────────────────────────────

# Enable debug mode (verbose logging, no optimizations)
# DEBUG=false

# Allow CORS from specific origin (default: "*" for development)
# CORS_ORIGINS=http://localhost:3000,https://myapp.com

# ════════════════════════════════════════════════════════════════════════════
# Setup Instructions
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Get OANDA credentials:
#    - Create free account: https://www.oanda.com
#    - Enable API access in account settings
#    - Generate API key (keep it secret!)
#    - Note your Account ID
#
# 2. Start with PRACTICE environment:
#    - OANDA_ENVIRONMENT=practice
#    - No real money trades will execute
#    - Perfect for testing
#
# 3. Database setup (optional):
#    - If using docker-compose, DB starts automatically
#    - If local Python, ensure PostgreSQL is running
#    - Or remove DATABASE_URL to run without audit logging
#
# 4. Run server:
#    - Docker: docker-compose up -d
#    - Local: python server.py
#    - Visit: http://localhost:8000/docs
#
# 5. Security:
#    - Commit .env.example (template), NOT .env (secrets)
#    - Use .gitignore to prevent accidental commits
#    - Keep API_KEY private!
#
# ════════════════════════════════════════════════════════════════════════════
